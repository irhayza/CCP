# Salin ke .env lalu sesuaikan. Semua opsional.

# Server. Default hanya bisa diakses dari komputer ini.
HOST=127.0.0.1
PORT=8000

# WAJIB bila HOST bukan 127.0.0.1 (mis. Docker / VPS / akses lewat Wi-Fi).
# Pakai string acak panjang: python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_TOKEN=

# Host video yang boleh dianalisis (pisahkan koma). Default: hanya YouTube.
# ALLOWED_HOSTS=youtube.com,www.youtube.com,m.youtube.com,music.youtube.com,youtu.be

# Render paralel. NVENC pada GPU konsumen biasanya membatasi sesi bersamaan (sekitar 3-8).
RENDER_WORKERS=2
MAX_CLIP_SECONDS=180
CACHE_TTL_HOURS=72

# Paksa urutan model Gemini (kosong = ambil otomatis dari akunmu, terbaru dulu).
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Lokasi data (database, cache, hasil render, cookies). Default: ./data
# DATA_DIR=./data

# Proksi untuk yt-dlp, mis. http://127.0.0.1:7890
# YTDLP_PROXY=

# Detektor wajah untuk face tracking: auto | yunet | haar
#   auto  = YuNet bila modelnya terpasang (python -m backend.models), selain itu Haar bawaan OpenCV
#   haar  = selalu Haar (tanpa unduhan model; butuh OpenCV 4.x, tidak ada di OpenCV 5)
# FACE_DETECTOR=auto
# Path file .onnx YuNet bila disimpan di luar DATA_DIR/models
# YUNET_MODEL=

# Transkrip Whisper (butuh: pip install faster-whisper)
# WHISPER_MODEL=small
# WHISPER_DEVICE=auto

# Izinkan tombol "Perbarui yt-dlp" di Pengaturan menjalankan pip.
# ALLOW_SELF_UPDATE=0
